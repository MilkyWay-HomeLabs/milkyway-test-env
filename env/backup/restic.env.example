# Copy to restic.env and replace CHANGE_ME.
#
# WARNING: RESTIC_PASSWORD is the encryption key of the repository, not a login.
# Changing it in this file does NOT re-key an existing repo — it makes every existing
# snapshot unreadable. To rotate on a live repository:
#
#   restic key add      # with the new password
#   restic key remove   # the old one, after verifying you can still read snapshots
#
# Losing this password means losing every backup in the repo. Keep a copy somewhere
# other than this machine.

RESTIC_REPOSITORY=/backups/restic-repo
RESTIC_PASSWORD=CHANGE_ME
