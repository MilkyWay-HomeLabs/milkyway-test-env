# Copy to mongo.env and replace every CHANGE_ME.
# MONGO_INITDB_* only take effect on an EMPTY data volume. To change the password of
# an existing deployment use db.changeUserPassword() — editing this file does nothing.

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
MONGO_INITDB_DATABASE=admin

MONGO_BACKUP_USER=backup
MONGO_BACKUP_PASSWORD=CHANGE_ME
MONGO_WAIT_TIMEOUT=60

# Consumed by sql/mongo/000_init_puzzel.js when initialising an empty volume.
PUZZEL_PASSWORD=CHANGE_ME
