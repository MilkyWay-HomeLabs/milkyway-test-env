# Copy to mariadb.env and replace every CHANGE_ME.
# Per-application database passwords (andromeda, nebula, chess, robak) do not live here —
# they sit in env/tomcat/*-rest.properties next to the app that uses them.

MARIADB_ROOT_PASSWORD=CHANGE_ME
MARIADB_DATABASE=milky_app
MARIADB_USER=milky_user
MARIADB_PASSWORD=CHANGE_ME
MARIADB_BACKUP_USER=backup
MARIADB_BACKUP_PASSWORD=CHANGE_ME
MARIADB_WAIT_TIMEOUT=60
