# Copy to postgres.env and replace every CHANGE_ME.
# HACMAN_PASSWORD is also embedded in the connection string in
# env/kestrel/hacman/back/.env — the two must always match.

POSTGRES_DB=
POSTGRES_USER=milky_user
POSTGRES_PASSWORD=CHANGE_ME

HACMAN_DB=hacman
HACMAN_TEST_DB=test_hacman
HACMAN_USER=hacman
HACMAN_PASSWORD=CHANGE_ME

PLAYERS_TEST_DB=test_players
PLAYERS_USER=players
PLAYERS_PASSWORD=CHANGE_ME

# ELEMENT_PASSWORD is also DB_PASSWORD in env/element/element-rest.env — the two
# must always match.
ELEMENT_TEST_DB=test_element
ELEMENT_USER=element
ELEMENT_PASSWORD=CHANGE_ME

POSTGRES_BACKUP_USER=backup
POSTGRES_BACKUP_PASSWORD=CHANGE_ME
POSTGRES_WAIT_TIMEOUT=60
