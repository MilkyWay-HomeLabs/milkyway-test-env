# element-rest-test — copy to element-rest.env and replace every CHANGE_ME.
#
# Unlike the older APIs, element-rest-api is a Spring Boot 4 fat jar running on a
# plain JRE, not a WAR in the shared Tomcat image. It reads plain environment
# variables (see application.yml), so this is an .env file and not a
# *.properties file mounted into Tomcat's conf/.

# PostgreSQL (D-002). Reached over the `internal` network, so the host is the
# container name — not localhost, which is where a local IDE run points instead.
# DB_PASSWORD must match ELEMENT_PASSWORD in env/db/postgres.env.
DB_HOST=postgres-test
DB_PORT=5432
DB_NAME=test_element
DB_USER=element
DB_PASSWORD=CHANGE_ME

# Traefik routes /element/api to this container on 8080; the app adds its own
# context path /element/api, so the route is passed through unstripped.
SERVER_PORT=8080

# Platform authentication (D-007). The accessToken cookie is issued by Andromeda
# and validated here locally with the same HS256 key — this service never calls
# the authorization server, and is deliberately not on auth-net.
# Must match APP_JWT_SECRET in env/tomcat/andromeda-authorization.properties.
APP_JWT_SECRET=CHANGE_ME
AUTH_COOKIE_DOMAIN=milkyway.test

# Signs gift keys (booster/credit codes redeemed in the panel). Element's own
# secret, shared with nothing.
GIFT_KEY_SECRET=CHANGE_ME
