# element-editor-rest-test — copy to element-editor-rest.env.

PORT=8080

# Shared secret required (as "Authorization: Bearer <token>") to call any
# write route (currently just POST /cards/:code/art) — see element-editor's
# own backend/adminAuth.ts. No default: leaving this unset makes every write
# fail closed with a 500, not open. Set the same value in the frontend's own
# admin-token field to actually use it.
ADMIN_TOKEN=CHANGE_ME

# element-rest-test directly by container name, not through the public HTTPS
# route: element-editor-rest-test is on the `internal` network specifically
# for this. Its context path is /element/api (application.yml); /v1 is the
# API's own versioned prefix on top of that.
ELEMENT_API_URL=http://element-rest-test:8080/element/api/v1
ELEMENT_API_TLS_INSECURE=false

# Where generated card art lands: bind-mounted to
# resources/test/element-editor/ on the host (docker-compose.yml).
OUTPUT_DIR=/app/output
