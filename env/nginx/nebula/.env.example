# Router base path for BrowserRouter basename
# Example for root: /
# Example for subpath: /nebula-home/
VITE_PUBLIC_URL=/

# App API and auth config used by src/data/Credentials.js
VITE_REQUEST_URL=https://api.example.com
VITE_USERNAME=demo-user
VITE_PASSWORD=demo-pass
VITE_TOMCAT_DOMAIN=https://example.com:8555
VITE_APACHE_DOMAIN=https://example.com
VITE_RESOURCES_DOMAIN=https://example.com/resources/
PLAYWRIGHT_IGNORE_HTTPS=1
PLAYWRIGHT_BASE_URL=https://milkyway.test/dev/nebula/app/
