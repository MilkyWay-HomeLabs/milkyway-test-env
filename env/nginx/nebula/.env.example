# Copy to .env and replace every CHANGE_ME.
#
# WARNING: VITE_* values are baked into the browser bundle at build time. Anything
# here ships to the client and is NOT secret. Treat VITE_PASSWORD as a low-value
# shared credential, never as a real one.

# Router base path for BrowserRouter basename
# Example for root: /
# Example for subpath: /nebula/app/
VITE_PUBLIC_URL=/

# App API and auth config used by src/data/Credentials.js
VITE_REQUEST_URL=https://milkyway.test/nebula/api/v1
VITE_USERNAME=CHANGE_ME
VITE_PASSWORD=CHANGE_ME
VITE_TOMCAT_DOMAIN=https://milkyway.test/nebula/api/
VITE_APACHE_DOMAIN=https://milkyway.test/nebula/app/
VITE_RESOURCES_DOMAIN=https://milkyway.test/resources/
PLAYWRIGHT_IGNORE_HTTPS=1
PLAYWRIGHT_BASE_URL=https://milkyway.test/dev/nebula/app/
