FRONT_APP_DIR_DEV_ENV=/path-to-docker/test/nginx/chess-front-app/dist
FRONT_ARCHIVE_DIR_DEV_ENV=/path-to-docker/test/nginx/chess-front-archive
DOCKER_TEST_DIR_TEST_ENV=/path-to-docker/test/nginx/chess-front-app

CHESS_FRONT_SERVICE_DEV=chess-front-test
PUBLIC_URL=/chess/app/
PUBLIC_URL_DEV=/chess/app/

# App credentials (see src/data/Credentials.js)
REACT_APP_USERNAME=chess
REACT_APP_PASSWORD=your_super_secret

# Backend / gateway domains
REACT_APP_APACHE_DOMAIN=https://milkyway.test
REACT_APP_TOMCAT_DOMAIN=https://milkyway.test
REACT_APP_REQUEST_URL=https://milkyway.test/chess/api/v1

# Nebula SSO login redirect + Nebula REST API
REACT_APP_NEBULA_LOGIN=https://milkyway.test/nebula/app/redirect?destination=Chess
REACT_APP_NEBULA_REST=https://milkyway.test/nebula/api/v1
