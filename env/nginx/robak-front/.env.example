FRONT_APP_DIR_DEV_ENV=/path-to-docker/test/nginx/robak-front-app/dist
FRONT_ARCHIVE_DIR_DEV_ENV=/path-to-docker/test/nginx/robak-front-archive
DOCKER_TEST_DIR_TEST_ENV=/path-to-docker/test/nginx/robak-front-app

ROBAK_FRONT_SERVICE_DEV=robak-front-test
PUBLIC_URL=/robak/app/
PUBLIC_URL_DEV=/robak/app/

# App credentials (see src/data/Credentials.js)
VITE_USERNAME=robak
VITE_PASSWORD=your_super_secret

# Backend / gateway domains
VITE_APACHE_DOMAIN=https://milkyway.test
VITE_TOMCAT_DOMAIN=https://milkyway.test
VITE_REQUEST_URL=https://milkyway.test/robak/api/v1

# Nebula SSO login redirect + Nebula REST API
VITE_NEBULA_LOGIN=https://milkyway.test/nebula/app/redirect?destination=Robak
VITE_NEBULA_REST=https://milkyway.test/nebula/api/v1
