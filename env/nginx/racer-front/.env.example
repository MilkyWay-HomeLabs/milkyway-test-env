FRONT_APP_DIR_DEV_ENV=/path-to-docker/test/nginx/racer-front/dist
FRONT_ARCHIVE_DIR_DEV_ENV=/path-to-docker/test/nginx/racer-front/archive
DOCKER_TEST_DIR_TEST_ENV=/path-to-docker/test/nginx/racer-front

RACER_FRONT_SERVICE_DEV=racer-front-test
PUBLIC_URL=/racer/app/
PUBLIC_URL_DEV=/racer/app/

# App credentials (see src/data/Credentials.js)
VITE_USERNAME=racer
VITE_PASSWORD=CHANGE_ME

# Backend / gateway domains
VITE_APACHE_DOMAIN=https://milkyway.test
VITE_TOMCAT_DOMAIN=https://milkyway.test
VITE_REQUEST_URL=https://milkyway.test/racer/api/v1

# Nebula SSO login redirect + Nebula REST API
VITE_NEBULA_LOGIN=https://milkyway.test/nebula/app/redirect?destination=Racer
VITE_NEBULA_REST=https://milkyway.test/nebula/api/v1
