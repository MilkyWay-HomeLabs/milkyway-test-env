# Example environment variables for hacman-app-front
# Copy this file to .env and fill in secrets. This file is intended to be committed.

# Base path where the app will be hosted (path base)
AppBasePath=/hacman/app

# Base URL for the Hacman API (must end with a slash)
HacmanApiBaseUrl=https://milkyway.test/hacman/api/

# Nebula token endpoint used by server-side token exchange
NEBULA_TOKEN_ENDPOINT=https://milkyway.test/nebula/api/

# Nebula API base URL used for server-to-server requests (NebulaClient)
NebulaApiBaseUrl=https://milkyway.test/nebula/api/

# Nebula OAuth client credentials (set real values in your local .env / CI secrets)
NEBULA_CLIENT_ID=your-client-id
NEBULA_CLIENT_SECRET=your-client-secret

# Login redirect used in UI when redirecting to Nebula (use double underscore for nested config keys)
NebulaApi__LoginUrl=https://milkyway.test/nebula/app/redirect?destination=Hacman

# Environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development

TrustSelfSignedCertificates=true
# or if not resolve then try:
# HacmanApiInternalUrl=http://hacman-app-back:8080/hacman/api/
