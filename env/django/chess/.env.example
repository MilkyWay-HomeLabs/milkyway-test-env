# chess-game-app — environment template.
# Copy to `.env` for local dev and fill in real values. NEVER commit a real .env.
# In test/prod the maintainer provides this file on the host (see docs/DEPLOYMENT.md
# → env/chess/.env). Consumed once settings.py reads env (ROADMAP Phase 0).
#
# Keys marked [DEV] / [PROD] differ per environment — the two blocks below show
# both. A single .env per environment is enough; there is no need to commit
# separate .env.dev / .env.prod / .env.test files (real values live on the host,
# dev values live in your local .env).

# ---- Django core ----
DJANGO_DEBUG=false
# Generate a strong, unique key per environment (e.g. `python -c "import secrets;print(secrets.token_urlsafe(64))"`).
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=milkyway.test
DJANGO_CSRF_TRUSTED_ORIGINS=https://milkyway.test

# ---- Sub-path & static (differs per environment) ----
# [PROD]
FORCE_SCRIPT_NAME=/chess/game
STATIC_URL=/chess/static/
# [DEV] (IDE / dev deploy) — use these instead:
# FORCE_SCRIPT_NAME=/dev/chess/game
# STATIC_URL=/dev/chess/static/

# ---- Proxy / TLS (Traefik terminates TLS; app speaks HTTP) ----
SECURE_PROXY_SSL_HEADER=1

# ---- Chess REST backend (see docs/BACKEND_INTEGRATION.md) ----
CHESS_API_BASE_URL=https://milkyway.test/chess/api/v1

# ---- Nebula auth gateway (Basic app credential + cookie session) ----
NEBULA_API_BASE_URL=https://milkyway.test/nebula/api/v1
GATEWAY_USERNAME=change-me
GATEWAY_PASSWORD=change-me

# ---- Optional DB override (defaults to local SQLite volume) ----
# DATABASE_URL=postgres://user:pass@host:5432/chess
