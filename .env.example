# Copy to .env and replace every CHANGE_ME.
#
# TRAEFIK_DASHBOARD_AUTH is an htpasswd entry. Generate it with:
#   docker run --rm httpd:alpine htpasswd -nbB admin 'your-password'
#
# Every '$' MUST be doubled to '$$', otherwise docker compose eats it as a variable
# reference and the hash silently becomes garbage.
TRAEFIK_DASHBOARD_AUTH=admin:CHANGE_ME
